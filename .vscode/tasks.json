		{
			"label": "build116_extract_prev_icon",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"git cat-file blob HEAD:assets/icons/app_icon.png > .tmp_prev_app_icon.png"
			]
		},
		{
			"label": "build116_outer_margin_black_cleanup",
			"type": "shell",
			"command": "Add-Type",
			"args": [
				"-AssemblyName",
				"System.Drawing;",
				"$path=Join-Path",
				"(Get-Location)",
				"'assets/icons/app_icon.png';",
				"$tmp=Join-Path",
				"(Get-Location)",
				"'assets/icons/app_icon.margin.tmp.png';",
				"$bmp=[System.Drawing.Bitmap]::FromFile($path);",
				"try",
				"{",
				"$w=$bmp.Width;",
				"$h=$bmp.Height;",
				"$gold=$bmp.GetPixel(0,0);",
				"$m=120;",
				"$changed=0;",
				"for($y=0;$y -lt $h;$y++){",
				"for($x=0;$x -lt $w;$x++){",
				"$inOuter=($x -lt $m -or $x -ge $w-$m -or $y -lt $m -or $y -ge $h-$m);",
				"if(-not $inOuter){",
				"continue",
				"};",
				"$c=$bmp.GetPixel($x,$y);",
				"$isNearBlack=($c.A -ge 200 -and $c.R -le 35 -and $c.G -le 35 -and $c.B -le 35);",
				"if($isNearBlack){",
				"$bmp.SetPixel($x,$y,$gold);",
				"$changed++",
				"}",
				"}",
				"};",
				"$bmp.Save($tmp,[System.Drawing.Imaging.ImageFormat]::Png);",
				"Write-Output",
				"\"outer-margin pixels replaced: $changed\"",
				"}",
				"finally",
				"{",
				"$bmp.Dispose()",
				"}",
				"Move-Item",
				"-Force",
				"$tmp",
				"$path"
			]
		},
