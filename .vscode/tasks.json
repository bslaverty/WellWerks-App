				"if(IsNearBlack",
				"($bmp.GetPixel($x,$h-1))){$edgeBlack++}",
				"};",
				"for($y=0;$y",
				"-lt",
				"$h;$y++){",
				"if(IsNearBlack",
				"($bmp.GetPixel(0,$y))){$edgeBlack++};",
				"if(IsNearBlack",
				"($bmp.GetPixel($w-1,$y))){$edgeBlack++}",
				"};",
				"$c1=$bmp.GetPixel(0,0);",
				"$c2=$bmp.GetPixel($w-1,0);",
				"$c3=$bmp.GetPixel(0,$h-1);",
				"$c4=$bmp.GetPixel($w-1,$h-1);",
				"Write-Output",
				"\"size=$w",
				"x",
				"$h\";",
				"Write-Output",
				"\"edgeNearBlackCount=$edgeBlack\";",
				"Write-Output",
				"\"corner1=$($c1.R),$($c1.G),$($c1.B),$($c1.A)\";",
				"Write-Output",
				"\"corner2=$($c2.R),$($c2.G),$($c2.B),$($c2.A)\";",
				"Write-Output",
				"\"corner3=$($c3.R),$($c3.G),$($c3.B),$($c3.A)\";",
				"Write-Output",
				"\"corner4=$($c4.R),$($c4.G),$($c4.B),$($c4.A)\";",
				"}",
				"finally",
				"{",
				"$bmp.Dispose()",
				"}"
			]
		},
		{
			"label": "build116_generate_icons",
			"type": "shell",
